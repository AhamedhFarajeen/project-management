PORT=8000
NODE_ENV=development
# Used by Express, Prisma CLI, account linking, and seeds. No code-level defaults.
# Replace all placeholders; percent-encode special characters in credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/project_management_portfolio?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Later: replace DATABASE_URL with the Neon Console connection string, including TLS parameters.
# Comma-separated exact frontend origins; add your real Vercel origin later.
CORS_ORIGINS=http://localhost:3000
# Existing FRONTEND_URL is accepted when CORS_ORIGINS is absent.
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Email of the first real Clerk account to promote to ADMIN (optional).
INITIAL_ADMIN_EMAIL="your-admin-email@example.com"
